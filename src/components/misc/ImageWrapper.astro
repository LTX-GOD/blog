---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	loading?: "lazy" | "eager";
	decoding?: "async" | "sync" | "auto";
	fetchpriority?: "high" | "low" | "auto";
	width?: number;
	height?: number;
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	loading = "lazy",
	decoding = "async",
	fetchpriority = "auto",
	width,
	height,
} = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	} else {
		img = await file();
	}
}

const isLazy = loading === 'lazy';
const imageClass = `w-full h-full object-cover${isLazy ? ' img-fade-in' : ''}`;
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative', { 'img-wrap': isLazy }]}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {isLocal && img && (
        <Image
            src={img}
            alt={alt || ""}
            class={imageClass}
            style={imageStyle}
            loading={loading}
            decoding={decoding}
            fetchpriority={fetchpriority}
            width={width}
            height={height}
        />
    )}
    {!isLocal && (
        <img
            src={isPublic ? url(src) : src}
            alt={alt || ""}
            class={imageClass}
            style={imageStyle}
            loading={loading}
            decoding={decoding}
            fetchpriority={fetchpriority}
            width={width}
            height={height}
        />
    )}
</div>

<script>
function initImgFadeIn() {
    document.querySelectorAll<HTMLImageElement>('.img-fade-in').forEach(img => {
        if (img.complete) {
            img.classList.add('img-loaded');
        } else {
            const onDone = () => img.classList.add('img-loaded');
            img.addEventListener('load', onDone, { once: true });
            img.addEventListener('error', onDone, { once: true });
        }
    });
}
initImgFadeIn();
if ((window as any).swup) {
    (window as any).swup.hooks.on('content:replace', initImgFadeIn);
} else {
    document.addEventListener('swup:enable', () => {
        (window as any).swup.hooks.on('content:replace', initImgFadeIn);
    }, { once: true });
}
</script>

---
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const moments: { id: number; content: string; date: string; images?: string[] }[] = [];

function formatTime(dateString: string): string {
	const now = new Date();
	const date = new Date(dateString);
	const diffInMinutes = Math.floor(
		(now.getTime() - date.getTime()) / (1000 * 60),
	);

	if (diffInMinutes < 60) {
		return `${diffInMinutes}${i18n(I18nKey.diaryMinutesAgo)}`;
	}
	if (diffInMinutes < 1440) {
		const hours = Math.floor(diffInMinutes / 60);
		return `${hours}${i18n(I18nKey.diaryHoursAgo)}`;
	}
	const days = Math.floor(diffInMinutes / 1440);
	return `${days}${i18n(I18nKey.diaryDaysAgo)}`;
}
---

<MainGridLayout title={i18n(I18nKey.diary)} description={i18n(I18nKey.diarySubtitle)}>
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">

			<!-- 页面标题 -->
			<div class="flex flex-col items-start mb-8 gap-1">
				<div class="flex items-center gap-3">
					<h1 class="text-3xl font-bold text-black/90 dark:text-white/90">{i18n(I18nKey.diary)}</h1>
					{moments.length > 0 && (
						<span class="text-sm font-bold px-2 py-0.5 rounded-full bg-[var(--primary)]/10 text-[var(--primary)]">
							{moments.length}
						</span>
					)}
				</div>
				<p class="text-base text-black/50 dark:text-white/50">{i18n(I18nKey.diarySubtitle)}</p>
			</div>

			<!-- 短文列表 -->
			<div class="space-y-4">
				{moments.length === 0 && (
					<div class="text-center py-16 text-75">
						{i18n(I18nKey.diaryTips)}
					</div>
				)}
				{moments.map(moment => (
					<div class="card-base p-5 md:p-6 hover:shadow-md transition-shadow duration-300">
						<p class="text-base text-90 leading-relaxed mb-4">{moment.content}</p>

						{moment.images && moment.images.length > 0 && (
							<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 mb-4">
								{moment.images.map((image) => (
									<div class="relative rounded-lg overflow-hidden aspect-square cursor-pointer">
										<img
											src={image}
											alt={i18n(I18nKey.diaryImage)}
											class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
											loading="lazy"
										/>
									</div>
								))}
							</div>
						)}

						<hr class="border-t border-[var(--line-divider)] mb-3" />

						<div class="flex items-center gap-1.5 text-75 text-sm">
							<span>🕐</span>
							<time datetime={moment.date}>{formatTime(moment.date)}</time>
						</div>
					</div>
				))}
			</div>

		</div>
	</div>
</MainGridLayout>

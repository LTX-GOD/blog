/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 20px
  --content-delay 150ms

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  // ── Rosé Pine ── Dawn (light) / Main (dark), iris accent ──
  --primary: #907aa9 #c4a7e7 // iris
  --page-bg: #faf4ed #191724 // base
  --card-bg: rgba(255, 250, 243, 0.75) rgba(31, 29, 46, 0.75) // surface (translucent)
  --card-bg-transparent: rgba(255, 250, 243, 0.6) rgba(31, 29, 46, 0.6)

  --btn-content: #575279 #e0def4 // text
  
  --btn-regular-bg: rgba(242, 233, 225, 0.8) rgba(38, 35, 58, 0.8) // overlay
  --btn-regular-bg-hover: rgba(223, 218, 217, 0.8) rgba(64, 61, 82, 0.8) // highlight med
  --btn-regular-bg-active: rgba(206, 202, 205, 0.8) rgba(82, 79, 103, 0.8) // highlight high

  --btn-plain-bg-hover: rgba(242, 233, 225, 0.8) rgba(38, 35, 58, 0.8)
  --btn-plain-bg-active: rgba(223, 218, 217, 0.8) rgba(64, 61, 82, 0.8)

  --btn-card-bg-hover: rgba(255, 250, 243, 0.8) rgba(38, 35, 58, 0.8)
  --btn-card-bg-active: rgba(242, 233, 225, 0.8) rgba(64, 61, 82, 0.8)

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: #575279 #e0def4 // text

  --title-active: #907aa9 #c4a7e7 // iris

  --line-divider: rgba(87, 82, 121, 0.1) rgba(224, 222, 244, 0.1)

  --line-color: rgba(87, 82, 121, 0.1) rgba(224, 222, 244, 0.1)
  --meta-divider: rgba(87, 82, 121, 0.2) rgba(224, 222, 244, 0.2)
  --content-meta: rgba(87, 82, 121, 0.7) #908caa // subtle

  --inline-code-bg: rgba(242, 233, 225, 0.9) rgba(38, 35, 58, 0.9) // overlay
  --inline-code-color: #286983 #9ccfd8 // pine / foam
  --selection-bg: #dfdad9 #403d52 // highlight
  --codeblock-selection: #403d52
  --codeblock-bg: rgba(242, 233, 225, 0.8) rgba(25, 23, 36, 0.97) // base
  --codeblock-topbar-bg: rgba(223, 218, 217, 0.8) rgba(31, 29, 46, 0.97) // surface
  --codeblock-border: rgba(87, 82, 121, 0.08) rgba(224, 222, 244, 0.08)

  --license-block-bg: rgba(0, 0, 0, 0.03) rgba(0, 0, 0, 0.2)

  --link-underline: #907aa9 #c4a7e7 // iris
  --link-hover: #907aa9 #c4a7e7 // iris
  --link-active: #d7827e #ebbcba // rose

  --float-panel-bg: rgba(255, 250, 243, 0.85) rgba(31, 29, 46, 0.85) // surface

  --scrollbar-bg-light: rgba(0, 0, 0, 0.4)
  --scrollbar-bg-hover-light: rgba(0, 0, 0, 0.5)
  --scrollbar-bg-active-light: rgba(0, 0, 0, 0.6)

  --scrollbar-bg-dark: rgba(255, 255, 255, 0.4)
  --scrollbar-bg-hover-dark: rgba(255, 255, 255, 0.5)
  --scrollbar-bg-active-dark: rgba(255, 255, 255, 0.6)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: #286983 #31748f // pine
  --admonitions-color-note: #56949f #9ccfd8 // foam
  --admonitions-color-important: #907aa9 #c4a7e7 // iris
  --admonitions-color-warning: #ea9d34 #f6c177 // gold
  --admonitions-color-caution: #b4637a #eb6f92 // love

  --toc-badge-bg: rgba(242, 233, 225, 0.8) rgba(38, 35, 58, 0.8)
  --toc-btn-hover: rgba(223, 218, 217, 0.8) rgba(64, 61, 82, 0.8)
  --toc-btn-active: rgba(206, 202, 205, 0.8) rgba(82, 79, 103, 0.8)
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: #907aa9 #c4a7e7 // iris
})

